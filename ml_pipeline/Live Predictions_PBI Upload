import pandas as pd

# 1. Load the ML predictions CSV
# Update this path to strictly match the location of your local data/ folder
df = pd.read_csv(r'C:\Path\To\Your\Project\data\2026_week10_predictions.csv')

# 2. Format the Home Perspective
home_df = df.copy()
home_df.rename(columns={'home_team': 'Team', 'away_team': 'Opponent'}, inplace=True)
home_df['Perspective'] = 'Home'

# 3. Format the Away Perspective
away_df = df.copy()
away_df.rename(columns={'away_team': 'Team', 'home_team': 'Opponent'}, inplace=True)
away_df['Perspective'] = 'Away'

# 4. Append both perspectives into a single master table for the Dim_Team hub
ml_predictions_pbi = pd.concat([home_df, away_df], ignore_index=True)

# 5. Clean up data types and round precise floats
ml_predictions_pbi['home_net_epa'] = ml_predictions_pbi['home_net_epa'].round(2)
ml_predictions_pbi['away_net_epa'] = ml_predictions_pbi['away_net_epa'].round(2)
ml_predictions_pbi['home_cpoe'] = ml_predictions_pbi['home_cpoe'].round(1)
ml_predictions_pbi['away_cpoe'] = ml_predictions_pbi['away_cpoe'].round(1)

